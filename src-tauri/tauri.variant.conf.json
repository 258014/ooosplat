{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OOOSplat 试验版",
  "identifier": "studio.ooo.splat.dev",
  "mainBinaryName": "ooo-splat-dev",
  "app": {
    "windows": [
      {
        "title": "OOOSplat 试验版",
        "width": 1500,
        "height": 850,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#eef1f5"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "compression": "bzip2"
      }
    }
  }
}
